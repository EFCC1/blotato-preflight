# Copy this file to .env and fill in the values.
# true = use the fake Blotato inside the app. false = use the real Blotato API.
BLOTATO_MOCK=true
# Your key from Blotato Settings > API. Paste it exactly, including any "=" at the end. Leave empty in mock mode.
BLOTATO_API_KEY=
# The port the app runs on. Change it if 3000 is busy.
PORT=3000
